@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center bg-dark text-white">
            <div class="fw-bold text-white d-none d-sm-block">
                Template Blazor Web App (SSR + Entra ID + Forms Auth)
            </div>
            <div>
                <UserClaimsBadge />
            </div>
        </div>

        <article class="content px-4 py-3">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro não tratado na aplicação.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>
