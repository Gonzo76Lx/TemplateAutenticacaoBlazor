<AuthorizeView>
    <Authorized>
        @{
            var user = context.User;
            var userType = user.FindFirst("UserType")?.Value ?? "Desconhecido";
            var provider = user.FindFirst("AuthenticationProvider")?.Value ?? "Cookie";
            var name = user.Identity?.Name ?? "Utilizador";
            var isInterno = userType.Equals("Interno", StringComparison.OrdinalIgnoreCase);
        }
        <div class="d-flex align-items-center gap-3">
            <div class="text-end d-none d-md-block">
                <div class="fw-bold text-truncate" style="max-width: 220px;">@name</div>
                <div class="d-flex gap-1 justify-content-end">
                    @if (isInterno)
                    {
                        <span class="badge bg-primary">Interno (Entra ID)</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Externo (Forms)</span>
                    }
                    <span class="badge bg-secondary">@provider</span>
                </div>
            </div>
            
            <a href="/auth/logout" class="btn btn-sm btn-outline-danger" title="Terminar Sessão">
                Terminar Sessão
            </a>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="d-flex gap-2">
            <a href="/externo/login" class="btn btn-sm btn-outline-light">
                Login Externo
            </a>
            <a href="/auth/login-entra" class="btn btn-sm btn-primary">
                Login Entra ID
            </a>
        </div>
    </NotAuthorized>
</AuthorizeView>
