@page "/interno"
@inject NavigationManager Navigation

<PageTitle>Portal Interno (Entra ID)</PageTitle>

<AuthorizeView>
    <Authorized>
        @{
            var user = context.User;
            var userType = user.FindFirst("UserType")?.Value ?? string.Empty;
            var isInterno = userType.Equals("Interno", StringComparison.OrdinalIgnoreCase);
        }

        @if (isInterno)
        {
            <div class="container-fluid py-2">
                <!-- Cabeçalho do Portal Interno -->
                <div class="p-4 mb-4 bg-primary text-white rounded-3 shadow-sm">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="fw-bold mb-1"><i class="bi bi-building"></i> Portal Interno da Organização</h2>
                            <p class="mb-0 text-white-50">
                                Autenticado com sucesso via <strong>Microsoft Entra ID</strong> | Sessão persistida em HttpCookie.
                            </p>
                        </div>
                        <span class="badge bg-light text-primary fs-6 p-2">Acesso Corporativo</span>
                    </div>
                </div>

                <!-- Perfil e Claims do Utilizador Interno -->
                <div class="row g-4 mb-4">
                    <div class="col-lg-5">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-header bg-dark text-white fw-bold">
                                Ficha do Colaborador (Entra ID)
                            </div>
                            <div class="card-body">
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item"><strong>Nome Completo:</strong> @user.Identity?.Name</li>
                                    <li class="list-group-item"><strong>Email Corporativo:</strong> @(user.FindFirst(ClaimTypes.Email)?.Value ?? user.FindFirst("preferred_username")?.Value ?? "N/A")</li>
                                    <li class="list-group-item"><strong>UserType:</strong> <span class="badge bg-primary">@userType</span></li>
                                    <li class="list-group-item"><strong>Departamento:</strong> @(user.FindFirst("Departamento")?.Value ?? "N/A")</li>
                                    <li class="list-group-item"><strong>Nível de Acesso:</strong> @(user.FindFirst("NivelAcesso")?.Value ?? "N/A")</li>
                                    <li class="list-group-item"><strong>Tenant ID:</strong> <code>@(user.FindFirst("TenantId")?.Value ?? "default-tenant")</code></li>
                                    <li class="list-group-item"><strong>Provedor de Auth:</strong> @(user.FindFirst("AuthenticationProvider")?.Value ?? "EntraID")</li>
                                </ul>

                                @{
                                    var entraGroups = user.FindAll("groups").Select(c => c.Value).ToList();
                                    var entraRoles = user.FindAll(ClaimTypes.Role).Concat(user.FindAll("roles")).Select(c => c.Value).Distinct().ToList();
                                }

                                <div class="mt-3">
                                    <h6 class="fw-bold text-secondary mb-2"><i class="bi bi-people-fill"></i> Grupos de Segurança (Entra ID Groups):</h6>
                                    @if (entraGroups.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var group in entraGroups)
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary-emphasis border font-monospace">@group</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <small class="text-muted fst-italic">Nenhum grupo mapeado no token. Ative a claim 'groups' no Azure Portal.</small>
                                    }
                                </div>

                                <div class="mt-3">
                                    <h6 class="fw-bold text-secondary mb-2"><i class="bi bi-shield-lock-fill"></i> Funções e Perfis (Roles):</h6>
                                    @if (entraRoles.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var role in entraRoles)
                                            {
                                                <span class="badge bg-success-subtle text-success-emphasis border">@role</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <small class="text-muted fst-italic">Nenhuma role atribuída.</small>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-7">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-header bg-secondary text-white fw-bold d-flex justify-content-between align-items-center">
                                <span>Todas as Claims do HttpCookie (Entra ID)</span>
                                <span class="badge bg-light text-dark">@user.Claims.Count() Claims</span>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive" style="max-height: 420px; overflow-y: auto;">
                                    <table class="table table-hover table-striped mb-0 table-sm">
                                        <thead class="table-light sticky-top">
                                            <tr>
                                                <th>Claim</th>
                                                <th>Valor</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var claim in user.Claims)
                                            {
                                                <tr>
                                                    <td><small class="fw-semibold">@claim.Type</small></td>
                                                    <td><code>@claim.Value</code></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Painel de Demonstração de Recursos Internos -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-light fw-bold">
                        Recursos Restritos a Colaboradores Internos
                    </div>
                    <div class="card-body">
                        <div class="row text-center g-3">
                            <div class="col-md-3">
                                <div class="p-3 border rounded bg-white shadow-sm">
                                    <div class="fs-4 text-primary fw-bold">Ativo</div>
                                    <div class="text-muted small">Estado Microsoft SSO</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-3 border rounded bg-white shadow-sm">
                                    <div class="fs-4 text-success fw-bold">Válido</div>
                                    <div class="text-muted small">HttpCookie de Autenticação</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-3 border rounded bg-white shadow-sm">
                                    <div class="fs-4 text-info fw-bold">8 Horas</div>
                                    <div class="text-muted small">Validade da Sessão</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-3 border rounded bg-white shadow-sm">
                                    <div class="fs-4 text-dark fw-bold">Total</div>
                                    <div class="text-muted small">Acesso Intranet</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="container py-5">
                <div class="alert alert-warning shadow-sm p-4">
                    <h4 class="alert-heading">Acesso Restrito ao Portal Interno</h4>
                    <p>
                        Encontra-se atualmente autenticado como utilizador <strong>Externo (Forms Authentication)</strong>.
                        O ponto de entrada <code>/interno</code> requer autenticação corporativa via <strong>Microsoft Entra ID</strong>.
                    </p>
                    <hr />
                    <div class="d-flex gap-2">
                        <a href="/auth/login-entra?returnUrl=/interno" class="btn btn-primary">
                            Entrar com Microsoft Entra ID
                        </a>
                        <a href="/externo" class="btn btn-outline-secondary">
                            Ir para Portal Externo
                        </a>
                    </div>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="container py-5 text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">A redirecionar...</span>
            </div>
            <p class="mt-3">Acesso restrito ao Portal Interno. A redirecionar para autenticação via Microsoft Entra ID...</p>
            <a href="/auth/login-entra?returnUrl=/interno" class="btn btn-primary mt-2">
                Clique aqui se não for redirecionado automaticamente
            </a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;
            if (user?.Identity == null || !user.Identity.IsAuthenticated)
            {
                Navigation.NavigateTo("/auth/login-entra?returnUrl=/interno", forceLoad: true);
            }
        }
    }
}
