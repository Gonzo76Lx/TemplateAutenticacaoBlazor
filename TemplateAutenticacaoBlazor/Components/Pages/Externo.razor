@page "/externo"
@inject NavigationManager Navigation

<PageTitle>Portal Externo (Forms Auth)</PageTitle>

<AuthorizeView>
    <Authorized>
        @{
            var user = context.User;
            var userType = user.FindFirst("UserType")?.Value ?? string.Empty;
            var isExterno = userType.Equals("Externo", StringComparison.OrdinalIgnoreCase);
        }

        <div class="container-fluid py-2">
            <!-- Cabeçalho do Portal Externo -->
            <div class="p-4 mb-4 bg-success text-white rounded-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="fw-bold mb-1"><i class="bi bi-people"></i> Portal de Clientes e Parceiros Externos</h2>
                        <p class="mb-0 text-white-50">
                            Autenticado via <strong>Forms Authentication</strong> (Login + REST Controller) | Sessão persistida em HttpCookie.
                        </p>
                    </div>
                    <span class="badge bg-light text-success fs-6 p-2">Portal Externo</span>
                </div>
            </div>

            <!-- Perfil e Claims do Utilizador Externo -->
            <div class="row g-4 mb-4">
                <div class="col-lg-5">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-header bg-dark text-white fw-bold">
                            Ficha do Cliente / Parceiro
                        </div>
                        <div class="card-body">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item"><strong>Nome Completo:</strong> @user.Identity?.Name</li>
                                <li class="list-group-item"><strong>Email:</strong> @(user.FindFirst(ClaimTypes.Email)?.Value ?? "N/A")</li>
                                <li class="list-group-item"><strong>UserType:</strong> <span class="badge bg-success">@userType</span></li>
                                <li class="list-group-item"><strong>Empresa:</strong> @(user.FindFirst("Empresa")?.Value ?? "N/A")</li>
                                <li class="list-group-item"><strong>NIF:</strong> <code>@(user.FindFirst("NIF")?.Value ?? "N/A")</code></li>
                                <li class="list-group-item"><strong>Plano:</strong> <span class="badge bg-info text-dark">@(user.FindFirst("PlanoSubscricao")?.Value ?? "Standard")</span></li>
                                <li class="list-group-item"><strong>Provedor de Auth:</strong> @(user.FindFirst("AuthenticationProvider")?.Value ?? "Forms")</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-header bg-secondary text-white fw-bold">
                            Claims Gravadas no HttpCookie (Utilizador Externo)
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive" style="max-height: 280px; overflow-y: auto;">
                                <table class="table table-hover table-striped mb-0 table-sm">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Claim</th>
                                            <th>Valor</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var claim in user.Claims)
                                        {
                                            <tr>
                                                <td><small class="fw-semibold">@claim.Type</small></td>
                                                <td><code>@claim.Value</code></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Serviços Disponíveis no Portal Externo -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light fw-bold">
                    Painel de Serviços Externos
                </div>
                <div class="card-body">
                    <div class="row text-center g-3">
                        <div class="col-md-3">
                            <div class="p-3 border rounded bg-white shadow-sm">
                                <div class="fs-4 text-success fw-bold">Ativo</div>
                                <div class="text-muted small">Estado da Subscrição</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border rounded bg-white shadow-sm">
                                <div class="fs-4 text-primary fw-bold">Válido</div>
                                <div class="text-muted small">HttpCookie Seguro</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border rounded bg-white shadow-sm">
                                <div class="fs-4 text-info fw-bold">8 Horas</div>
                                <div class="text-muted small">Duração da Sessão</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border rounded bg-white shadow-sm">
                                <div class="fs-4 text-warning fw-bold">Cliente</div>
                                <div class="text-muted small">Âmbito de Acesso</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container py-5 text-center">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">A redirecionar...</span>
            </div>
            <p class="mt-3">Acesso restrito ao Portal Externo. A redirecionar para a página de login...</p>
            <a href="/externo/login?returnUrl=/externo" class="btn btn-success mt-2">
                Clique aqui se não for redirecionado automaticamente
            </a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;
            if (user?.Identity == null || !user.Identity.IsAuthenticated)
            {
                Navigation.NavigateTo("/externo/login?returnUrl=/externo", forceLoad: true);
            }
        }
    }
}
