{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Information"
    }
  },
  "AllowedHosts": "*",
  
  "AuthSettings": {
    "CookieName": "TemplateBlazor_AuthCookie",
    "ExpireHours": 8,
    "SlidingExpiration": true
  },

  "DomainRouting": {
    "InternalDomainPattern": "interno",
    "ExternalDomainPattern": "externo",
    "InternalLoginPath": "/auth/login-entra",
    "ExternalLoginPath": "/externo/login",
    "AutoEnforceByDomain": true,
    "DebugOverrideMode": "Externo"
  },

  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "suaempresa.onmicrosoft.com",
    "TenantId": "YOUR_ENTRA_ID_TENANT_ID_OR_COMMON",
    "ClientId": "YOUR_ENTRA_ID_CLIENT_ID",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },

  "FormsAuthDemoUsers": [
